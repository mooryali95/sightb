# Copy to .env for local development. In deployed environments these must be
# supplied by the platform's environment settings — the values are inlined into
# the client bundle at build time, so a build without them ships a Supabase
# client pointing at `undefined` (src/main.tsx refuses to boot in that case).

# Required — read by src/integrations/supabase/client.ts
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Informational only: no code path reads this today. Kept because the Lovable
# tooling writes it alongside the two above.
VITE_SUPABASE_PROJECT_ID=""
